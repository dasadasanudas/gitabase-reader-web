{
  "name": "Gitabase Reader",
  "short_name": "Gitabase",
  "description": "Read Gitabase books: verses, word-by-word, translations and purports, with notes and search.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7dfb5",
  "theme_color": "#7b5549",
  "icons": [
    {
      "src": "img/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}